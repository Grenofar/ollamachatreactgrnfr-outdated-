# Copy to .env (gitignored) and fill in real values.
# Used only for publishing releases (upload installer + insert app_releases
# row) — never read by the app itself or committed to git. See CLAUDE.md,
# section "Publier une release", for how it's used.

SUPABASE_URL=https://xxxx.supabase.co

# service_role key (Supabase dashboard -> Settings -> API). Bypasses every
# Row Level Security policy on the whole project — treat it like a root
# password, never the anon key. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
