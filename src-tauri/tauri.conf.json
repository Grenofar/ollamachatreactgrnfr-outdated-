{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ollama-chat-react",
  "version": "1.0.8",
  "identifier": "com.userasus.ollama-chat-react",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ollama-chat-react",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https: wss:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Grenofar",
    "shortDescription": "Client de chat pour Ollama avec éditeur de code agentique (Codex)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ollamachat"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNTE1ODQ4NTEwNEI2QzkKUldUSnRnUlJTRmhSYndjSjB0SlVtQkQ4U2dneXh5Z0NoK1FIQzY2UWcrVXZqbTY0VmRRbU13cWsK",
      "endpoints": [
        "https://cihuwuiyziarnghethbi.supabase.co/rest/v1/rpc/latest_release_manifest"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
